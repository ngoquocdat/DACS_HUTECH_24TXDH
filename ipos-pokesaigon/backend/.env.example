# =============================================
# Backend Environment Variables Template
# =============================================
# Copy this file: cp .env.example .env
# Fill in the values from aws.config.example
# NEVER commit .env to git

# AWS Region
AWS_REGION=us-east-1

# DynamoDB table name
DYNAMODB_TABLE_NAME=PokesaigonOrders

# Leave empty for AWS production. Set to http://localhost:8000 for DynamoDB Local.
DYNAMODB_ENDPOINT=

# CORS allowed origin (* for dev)
CORS_ORIGIN=http://localhost:5173

# Optional SNS topic ARN for kitchen notifications (leave empty to disable)
SNS_NEW_ORDER_TOPIC_ARN=

# Optional S3 bucket for receipt export (leave empty to disable)
S3_RECEIPT_BUCKET=

# Public Cognito client ID (from the matching AWS stack); mandatory for handler RBAC
COGNITO_CLIENT_ID=your-cognito-app-client-id
