# =============================================
# Frontend Environment Variables Template
# =============================================
# Copy this file: cp .env.example .env
# NEVER commit .env to git

# API Gateway base URL — get this from infra deployment output
# Format: https://{api-id}.execute-api.{region}.amazonaws.com
# For local testing with SAM: http://localhost:3000
VITE_API_BASE_URL=https://your-api-id.execute-api.ap-southeast-1.amazonaws.com
